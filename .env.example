# Copie este arquivo para ".env" e preencha com os valores reais.
# NUNCA suba o .env de verdade pro GitHub (coloque no .gitignore).

# --- Já existiam na Fase 2 ---
PRIVATE_KEY=
WALLET_ADDRESS=
CONTRACT_ADDRESS=
RPC_URL=
PINATA_JWT=

# --- Novos, da Fase 3 ---

# Endereço do contrato DePinToken.sol depois do deploy no Remix
TOKEN_CONTRACT_ADDRESS=

# Quantidade de tokens DEPIN enviada por ocorrência concluída
TOKEN_REWARD_AMOUNT=10

# Porta serial da antena (Arduino). Ajuste conforme o sistema:
#   Windows: COM3, COM4, ...
#   Mac:     /dev/cu.usbmodemXXXX  ou  /dev/cu.usbserial-XXXX
#   Linux:   /dev/ttyUSB0  ou  /dev/ttyACM0
SERIAL_PORT=/dev/ttyUSB0
BAUD_RATE=9600
